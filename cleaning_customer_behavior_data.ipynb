   "source": [
    "# Define the table name\n",
    "table_name = \"customer_behavior_data\"\n",
    "\n",
    "# Upload the cleaned DataFrame to PostgreSQL\n",
    "dh.to_sql(\n",
    "    name=table_name,\n",
    "    con=engine,\n",
    "    schema=\"public\",\n",
    "    if_exists=\"replace\",\n",
    "    index=False\n",
    ")\n",
    "\n",
    "# Display a confirmation message\n",
    "print(\"Data successfully uploaded to PostgreSQL!\")"
   ]
